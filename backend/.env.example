APP_ENV=local
DATABASE_URL=sqlite:///./llm_eval.db

# LLM Provider Configuration
# Leave blank to use clearly labeled Mock Mode, or set your OpenAI / Anthropic API keys for live evaluations
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Concurrency & Execution Limits
DEFAULT_TIMEOUT_SECONDS=30.0
MAX_CONCURRENCY=5
